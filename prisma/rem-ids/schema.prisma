// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/rem-ids/client"
}

datasource db {
  provider = "postgresql"
  url      = env("REM_IDS_DB_URL")
}

enum EAccountProvider {
  Email
  Google
  Facebook
}

enum ERole {
  Admin
  User
  Guest
}

enum EGender {
  Male
  Female
  Other
}

model Oidc {
  id         String    @id
  type       Int
  payload    Json
  grantId    String?
  userCode   String?
  uid        String?   @unique
  expiresAt  DateTime?
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([id, type])
  @@map("oidc")
}

model User {
  id String @id @default(uuid())

  email      String  @unique
  hash       String?
  googleId   String? @unique @db.VarChar(50)
  facebookId String? @unique @db.VarChar(50)
  hashRt     String?
  verified   Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt() @db.Timestamp()

  profile Profile?

  provider EAccountProvider
  role     ERole            @default(Guest)

  devices      UserDevice[]
  loginHistory LoginHistory[]
}

model Profile {
  userId String @id

  displayName   String?   @db.VarChar(100)
  photoUrl      String?
  backgroundUrl String?
  bio           String?   @db.VarChar(400)
  setting       Json      @default("{}")
  birthday      DateTime? @db.Timestamp()
  gender        EGender?

  updatedTime DateTime? @updatedAt() @db.Timestamp()

  user User @relation(fields: [userId], references: [id])
}

model UserDevice {
  id     String @id @default(uuid())
  userId String

  deviceId    String   @unique @db.VarChar(50)
  deviceType  String   @db.VarChar(200)
  verified    Boolean  @default(false)
  userAgent   String   @db.Text
  isCurrent   Boolean  @default(false)
  lastLoginAt DateTime
  lastLoginIp String   @db.Inet

  user    User?          @relation(fields: [userId], references: [id])
  history LoginHistory[]
}

model LoginHistory {
  id     String @id @default(uuid())
  userId String

  deviceId String @unique @db.VarChar(50)

  loginAt DateTime @default(now())
  loginIp String   @db.Inet

  user   User?       @relation(fields: [userId], references: [id])
  device UserDevice? @relation(fields: [deviceId], references: [id])
}
