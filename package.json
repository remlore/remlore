  "scripts": {
    "ng": "ng",
    "nx": "nx",
    "start:rem": "nx run rem:serve:development",
    "start:rem-game": "nx run rem-game:serve:development",
    "start:rem-words": "nx run rem-words:serve:development",
    "start:ids-fe": "nx run rem-ids-fe:serve:development",
    "start:ids": "nx run rem-ids:serve:development",
    "start:words-api": "nx run rem-words-api:serve:development",
    "start:api": "nx run rem-api:serve:development",
    "scrape:init": "nx run rem-api:scrape:init",
    "prisma:gen:api": "prisma generate --schema libs/api/prisma/schema.prisma",
    "prisma:gen:ids": "prisma generate --schema libs/ids/core/prisma/schema.prisma",
    "prisma:gen:words": "prisma generate --schema libs/words-api/prisma/schema.prisma",
    "prisma:studio:api": "prisma studio --schema libs/api/prisma/schema.prisma",
    "prisma:studio:ids": "prisma studio --config libs/ids/core/prisma/prisma.config.ts",
    "prisma:studio:words": "prisma studio --schema libs/words-api/prisma/schema.prisma",
    "prisma:migrate:dev-api": "prisma migrate dev --schema libs/api/prisma/schema.prisma --name ",
    "prisma:migrate:dev-ids": "prisma migrate dev --config libs/ids/core/prisma/prisma.config.ts",
    "prisma:migrate:dev-words": "prisma migrate dev --schema libs/words-api/prisma/schema.prisma --name ",
    "prisma:migrate:deploy-api": "npx prisma migrate deploy --schema libs/api/prisma/schema.prisma --preview-feature",
    "prisma:migrate:deploy-ids": "npx prisma migrate deploy  --config libs/ids/core/prisma/prisma.config.ts",
    "prisma:migrate:deploy-words": "npx prisma migrate deploy --schema libs/words-api/prisma/schema.prisma --preview-feature",
    "prisma:dbpush:api": "npx prisma db push --schema libs/api/prisma/schema.prisma",
    "prisma:dbpush:ids": "npx prisma db push --schema libs/ids/core/prisma/schema.prisma",
    "prisma:dbpush:words": "npx prisma db push --schema libs/words-api/prisma/schema.prisma",
    "build:prod": "cross-env NODE_ENV=production ng build --configuration production",
    "lint": "nx workspace-lint && ng lint",
    "dep-graph": "nx dep-graph",
    "affected": "nx affected",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint --base=main",
    "affected:dep-graph": "nx affected:dep-graph",
    "update": "nx migrate latest",
    "test": "--jest --watch --no-cache"
  },
