  "scripts": {
    "ng": "ng",
    "nx": "nx",
    "start:rem": "nx run rem:serve:development -o",
    "start:rem-game": "nx run rem-game:serve:development -o",
    "start:ids-fe": "nx run rem-ids-fe:serve:development -o",
    "start:rem:test": "nx run serve rem-e2e",
    "start:api": "nx run rem-api:serve:development",
    "scrape:init": "nx run rem-api:scrape:init",
    "start:ids": "nx run rem-ids:serve:development",
    "prisma:gen:api": "prisma generate --schema prisma/rem-api/schema.prisma",
    "prisma:gen:ids": "prisma generate --schema prisma/rem-ids/schema.prisma",
    "prisma:studio:api": "prisma studio --schema prisma/rem-api/schema.prisma",
    "prisma:studio:ids": "prisma studio --schema prisma/rem-ids/schema.prisma",
    "prisma:migrate:dev-api": "prisma migrate dev --schema prisma/rem-api/schema.prisma --name ",
    "prisma:migrate:dev-ids": "prisma migrate dev --schema prisma/rem-ids/schema.prisma --name ",
    "prisma:migrate:deploy-api": "npx prisma migrate deploy --schema prisma/rem-api/schema.prisma --preview-feature",
    "prisma:migrate:deploy-ids": "npx prisma migrate deploy --schema prisma/rem-ids/schema.prisma --preview-feature",
    "prisma:dbpush:api": "npx prisma db push --schema prisma/rem-api/schema.prisma",
    "prisma:dbpush:ids": "npx prisma db push --schema prisma/rem-ids/schema.prisma",
    "build:prod": "cross-env NODE_ENV=production ng build --configuration production",
    "lint": "nx workspace-lint && ng lint",
    "dep-graph": "nx dep-graph",
    "affected": "nx affected",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint --base=main",
    "affected:dep-graph": "nx affected:dep-graph",
    "update": "nx migrate latest",
    "test": "--jest --watch --no-cache"
  },
