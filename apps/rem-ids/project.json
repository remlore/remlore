{
  "name": "rem-ids",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/rem-ids/src",
  "projectType": "application",
  "tags": ["type:app", "scope:rem-ids"],
  "targets": {
    "build": {
      "executor": "@nrwl/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/rem-ids",
        "main": "apps/rem-ids/src/main.ts",
        "tsConfig": "apps/rem-ids/tsconfig.app.json",
        "assets": [
          "apps/rem-ids/src/favicon.ico",
          {
            "glob": "**/*",
            "input": "libs/ids/shared/assets/src",
            "output": "/"
          }
        ],
        "isolatedConfig": true,
        "webpackConfig": "apps/rem-ids/webpack.config.js",
        "envFile": "apps/rem-ids/.env"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "rem-ids:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "rem-ids:build:development"
        },
        "production": {
          "buildTarget": "rem-ids:build:production"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/rem-ids/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/rem-api/**/*.ts"]
      }
    }
  }
}
